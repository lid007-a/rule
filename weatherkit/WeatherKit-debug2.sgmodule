#!name = WeatherKit 诊断2
#!desc = 诊断 bodyBytes 传递。
#!system = iOS

[Rule]
DOMAIN,weather-analytics-events.apple.com,REJECT-DROP
DOMAIN-SUFFIX,tthr.apple.com,REJECT-DROP,extended-matching
DOMAIN,tether.edge.apple,REJECT-DROP,extended-matching
AND,((OR,((IP-ASN,714,no-resolve),(IP-ASN,6185,no-resolve))),(PROTOCOL,QUIC)),REJECT-DROP

[Script]
🌤 DBG2 v3 = type=http-response, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v3\/weather\/, requires-body=1, binary-body-mode=1, engine=webview, script-path=https://raw.githubusercontent.com/lid007-a/rule/main/weatherkit/wk-dbg2.js, argument=Weather.Provider=WeatherKit&NextHour.Provider=ColorfulClouds&LogLevel=WARN
🌤 DBG2 v2 = type=http-response, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v2\/weather\/, requires-body=1, binary-body-mode=1, engine=webview, script-path=https://raw.githubusercontent.com/lid007-a/rule/main/weatherkit/wk-dbg2.js, argument=Weather.Provider=WeatherKit&NextHour.Provider=ColorfulClouds&LogLevel=WARN

[MITM]
hostname = %APPEND% weatherkit.apple.com
