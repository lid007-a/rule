#!name = WK3 完整版 v10
#!desc = 当前天气 + 逐小时 + 逐日由彩云替换；空气质量改写（有表则改，无表则注入）；分钟降水与预警按配置替换。
#!system = iOS
#!version = 3.3.3-v10

[Rule]
DOMAIN,weather-analytics-events.apple.com,REJECT-DROP
DOMAIN-SUFFIX,tthr.apple.com,REJECT-DROP,extended-matching
DOMAIN,tether.edge.apple,REJECT-DROP,extended-matching
AND,((OR,((IP-ASN,714,no-resolve),(IP-ASN,6185,no-resolve))),(PROTOCOL,QUIC)),REJECT-DROP

[Script]
WK3量表 = type=http-request, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v[12]\/airQualityScale\/, engine=webview, script-path=https://raw.githubusercontent.com/lid007-a/rule/main/weatherkit/wk3-fix-req-v1.js, argument=DataSets="airQuality,currentWeather,forecastDaily,forecastHourly,forecastNextHour,locationInfo,news,historicalComparisons,weatherAlerts,weatherChanges"&Weather.Replace="CN"&Weather.Provider="ColorfulClouds"&Weather.ReplaceDaily="true"&Weather.ReplaceHourly="true"&WeatherAlerts.Provider="QWeatherWeb"&NextHour.Provider="ColorfulClouds"&AirQuality.Current.Index.Provider="ColorfulCloudsCN"&AirQuality.Current.Index.Replace="HJ6332012"&AirQuality.Current.Index.ForceCNPrimaryPollutants="true"&AirQuality.Current.Pollutants.Provider="ColorfulClouds"&AirQuality.Comparison.ReplaceWhenCurrentChange="true"&AirQuality.Comparison.Yesterday.IndexProvider="ColorfulCloudsCN"&AirQuality.Calculate.Algorithm="WAQI_InstantCast_CN"&API.ColorfulClouds.Token=""&API.QWeather.Host="devapi.qweather.com"&API.QWeather.Token=""&LogLevel="INFO"&HTTP_TIMEOUT_MS="8000"
WK3本地响应 = type=http-response, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v3\/weather\/, requires-body=1, binary-body-mode=1, engine=webview, script-path=https://raw.githubusercontent.com/lid007-a/rule/main/weatherkit/wk3-full-v10.js, argument=DataSets="airQuality,currentWeather,forecastDaily,forecastHourly,forecastNextHour,locationInfo,news,historicalComparisons,weatherAlerts,weatherChanges"&Weather.Replace="CN"&Weather.Provider="ColorfulClouds"&Weather.ReplaceDaily="true"&Weather.ReplaceHourly="true"&WeatherAlerts.Provider="QWeatherWeb"&NextHour.Provider="ColorfulClouds"&AirQuality.Current.Index.Provider="ColorfulCloudsCN"&AirQuality.Current.Index.Replace="HJ6332012"&AirQuality.Current.Index.ForceCNPrimaryPollutants="true"&AirQuality.Current.Pollutants.Provider="ColorfulClouds"&AirQuality.Comparison.ReplaceWhenCurrentChange="true"&AirQuality.Comparison.Yesterday.IndexProvider="ColorfulCloudsCN"&AirQuality.Calculate.Algorithm="WAQI_InstantCast_CN"&API.ColorfulClouds.Token=""&API.QWeather.Host="devapi.qweather.com"&API.QWeather.Token=""&LogLevel="INFO"&HTTP_TIMEOUT_MS="8000"

[MITM]
hostname = %APPEND% weatherkit.apple.com
