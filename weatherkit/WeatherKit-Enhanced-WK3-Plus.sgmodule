#!name = 🌤 天气增强 · WK3 Plus
#!desc = 当前、逐小时、逐日可由彩云或和风替换，含逐小时天气图标同步；空气质量支持彩云美标/国标、和风、WAQI、本地 11 种算法；分钟降水在底座失败时兜底注入；无数据表点位自动补入；可用性响应同步重写。
#!system = iOS
#!version = 2.4.0
#!homepage = https://github.com/patrickyanxxxxx/WeatherKit-WK3
#!arguments = DataSets:"airQuality,currentWeather,forecastDaily,forecastHourly,forecastNextHour,locationInfo,news,historicalComparisons,weatherAlerts,weatherChanges",Weather.Provider:"ColorfulClouds",Weather.Replace:"CN",Weather.ReplaceConditionCode:"true",NextHour.Provider:"ColorfulClouds",WeatherAlerts.Provider:"QWeatherWeb",AirQuality.Current.Index.Provider:"ColorfulCloudsUS",AirQuality.Current.Index.Replace:"HJ6332012",AirQuality.Calculate.Algorithm:"WAQI_InstantCast_CN",AirQuality.Calculate.AllowOverRange:"true",AirQuality.Comparison.ReplaceWhenCurrentChange:"true",AirQuality.Comparison.Yesterday.IndexProvider:"ColorfulCloudsCN",AirQuality.Comparison.Yesterday.PollutantsProvider:"ColorfulCloudsCN",API.ColorfulClouds.Token:"",API.QWeather.Host:"devapi.qweather.com",API.QWeather.Token:"",API.WAQI.Token:"",LogLevel:"INFO"
#!arguments-desc = Weather.Provider: 天气数据源（ColorfulClouds 彩云 / QWeather 和风）。\nWeather.Replace: 替换范围国家码，默认 CN。\nNextHour.Provider: 分钟降水数据源（ColorfulClouds / WeatherKit 不替换）。\nWeatherAlerts.Provider: 预警来源（QWeatherWeb 网页补全 / WeatherKit 不替换）。\nAirQuality.Current.Index.Provider: 空气指数来源。ColorfulCloudsUS / ColorfulCloudsCN / QWeather / WAQI / Calculate。\nAirQuality.Current.Index.Replace: 需替换的原始标准，默认 HJ6332012。\nAirQuality.Calculate.Algorithm: 本地计算算法，共 11 种。国标 WAQI_InstantCast_CN / 国标2025草案 / 美标 WAQI_InstantCast_US / 欧盟 EU_EAQI / 德国 UBA / 香港 HK_AQHI / 加拿大 CA_AQHI / 中国死亡负担 CN_DEATH_AQHI / CN_DEATH_HK_AQHI / 多污染物 AQHI_Multi_CN / AQHI_Multi_CN_HK。仅 Provider 选 Calculate 时生效。\nAirQuality.Calculate.AllowOverRange: 指数超过 500 时是否保留原值。true 保留（上限 999），false 截断为 500。\nAirQuality.Comparison.ReplaceWhenCurrentChange: 今日指数变化时是否重算昨日对比。\nAirQuality.Comparison.Yesterday.IndexProvider: 昨日指数来源。\nAirQuality.Comparison.Yesterday.PollutantsProvider: 昨日污染物来源。\nAPI.ColorfulClouds.Token / API.QWeather.Host / API.QWeather.Token / API.WAQI.Token: 各数据源令牌。\nLogLevel: 脚本内部日志等级。

[Rule]
DOMAIN,weather-analytics-events.apple.com,REJECT-DROP
DOMAIN-SUFFIX,tthr.apple.com,REJECT-DROP,extended-matching
DOMAIN,tether.edge.apple,REJECT-DROP,extended-matching
AND,((OR,((IP-ASN,714,no-resolve),(IP-ASN,6185,no-resolve))),(PROTOCOL,QUIC)),REJECT-DROP

[Script]
天气增强·可用性 = type=http-response, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v[12]\/availability\/, requires-body=1, engine=webview, script-path=https://raw.githubusercontent.com/lid007-a/rule/main/weatherkit/WeatherKit-WK3-Response-v24.js, argument=DataSets="{{{DataSets}}}"&Weather.Provider="{{{Weather.Provider}}}"&Weather.Replace="{{{Weather.Replace}}}"&Weather.ReplaceConditionCode="{{{Weather.ReplaceConditionCode}}}"&NextHour.Provider="{{{NextHour.Provider}}}"&WeatherAlerts.Provider="{{{WeatherAlerts.Provider}}}"&AirQuality.Current.Index.Provider="{{{AirQuality.Current.Index.Provider}}}"&AirQuality.Current.Index.Replace="{{{AirQuality.Current.Index.Replace}}}"&AirQuality.Calculate.Algorithm="{{{AirQuality.Calculate.Algorithm}}}"&AirQuality.Calculate.AllowOverRange="{{{AirQuality.Calculate.AllowOverRange}}}"&AirQuality.Comparison.ReplaceWhenCurrentChange="{{{AirQuality.Comparison.ReplaceWhenCurrentChange}}}"&AirQuality.Comparison.Yesterday.IndexProvider="{{{AirQuality.Comparison.Yesterday.IndexProvider}}}"&AirQuality.Comparison.Yesterday.PollutantsProvider="{{{AirQuality.Comparison.Yesterday.PollutantsProvider}}}"&API.ColorfulClouds.Token="{{{API.ColorfulClouds.Token}}}"&API.QWeather.Host="{{{API.QWeather.Host}}}"&API.QWeather.Token="{{{API.QWeather.Token}}}"&API.WAQI.Token="{{{API.WAQI.Token}}}"&LogLevel="{{{LogLevel}}}"
天气增强·空气质量量表 = type=http-request, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v[12]\/airQualityScale\/, engine=webview, script-path=https://raw.githubusercontent.com/lid007-a/rule/main/weatherkit/WeatherKit-WK3-Scale.js, argument=DataSets="{{{DataSets}}}"&Weather.Provider="{{{Weather.Provider}}}"&Weather.Replace="{{{Weather.Replace}}}"&Weather.ReplaceConditionCode="{{{Weather.ReplaceConditionCode}}}"&NextHour.Provider="{{{NextHour.Provider}}}"&WeatherAlerts.Provider="{{{WeatherAlerts.Provider}}}"&AirQuality.Current.Index.Provider="{{{AirQuality.Current.Index.Provider}}}"&AirQuality.Current.Index.Replace="{{{AirQuality.Current.Index.Replace}}}"&AirQuality.Calculate.Algorithm="{{{AirQuality.Calculate.Algorithm}}}"&AirQuality.Calculate.AllowOverRange="{{{AirQuality.Calculate.AllowOverRange}}}"&AirQuality.Comparison.ReplaceWhenCurrentChange="{{{AirQuality.Comparison.ReplaceWhenCurrentChange}}}"&AirQuality.Comparison.Yesterday.IndexProvider="{{{AirQuality.Comparison.Yesterday.IndexProvider}}}"&AirQuality.Comparison.Yesterday.PollutantsProvider="{{{AirQuality.Comparison.Yesterday.PollutantsProvider}}}"&API.ColorfulClouds.Token="{{{API.ColorfulClouds.Token}}}"&API.QWeather.Host="{{{API.QWeather.Host}}}"&API.QWeather.Token="{{{API.QWeather.Token}}}"&API.WAQI.Token="{{{API.WAQI.Token}}}"&LogLevel="{{{LogLevel}}}"
天气增强·WK3响应 = type=http-response, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v[23]\/weather\/, requires-body=1, binary-body-mode=1, engine=webview, script-path=https://raw.githubusercontent.com/lid007-a/rule/main/weatherkit/WeatherKit-WK3-Response-v24.js, argument=DataSets="{{{DataSets}}}"&Weather.Provider="{{{Weather.Provider}}}"&Weather.Replace="{{{Weather.Replace}}}"&Weather.ReplaceConditionCode="{{{Weather.ReplaceConditionCode}}}"&NextHour.Provider="{{{NextHour.Provider}}}"&WeatherAlerts.Provider="{{{WeatherAlerts.Provider}}}"&AirQuality.Current.Index.Provider="{{{AirQuality.Current.Index.Provider}}}"&AirQuality.Current.Index.Replace="{{{AirQuality.Current.Index.Replace}}}"&AirQuality.Calculate.Algorithm="{{{AirQuality.Calculate.Algorithm}}}"&AirQuality.Calculate.AllowOverRange="{{{AirQuality.Calculate.AllowOverRange}}}"&AirQuality.Comparison.ReplaceWhenCurrentChange="{{{AirQuality.Comparison.ReplaceWhenCurrentChange}}}"&AirQuality.Comparison.Yesterday.IndexProvider="{{{AirQuality.Comparison.Yesterday.IndexProvider}}}"&AirQuality.Comparison.Yesterday.PollutantsProvider="{{{AirQuality.Comparison.Yesterday.PollutantsProvider}}}"&API.ColorfulClouds.Token="{{{API.ColorfulClouds.Token}}}"&API.QWeather.Host="{{{API.QWeather.Host}}}"&API.QWeather.Token="{{{API.QWeather.Token}}}"&API.WAQI.Token="{{{API.WAQI.Token}}}"&LogLevel="{{{LogLevel}}}"

[MITM]
hostname = %APPEND% weatherkit.apple.com
