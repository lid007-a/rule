#!name = 🌤 天气增强 · WK3 Plus
#!desc = 当前、逐小时、逐日可由彩云或和风替换；空气质量支持彩云美标/国标、和风、WAQI、以及本地按 5 种算法计算；无数据表的点位自动注入；分钟降水与预警沿用底座实现。
#!system = iOS
#!version = 1.9.0
#!homepage = https://github.com/patrickyanxxxxx/WeatherKit-WK3
#!arguments = DataSets:"airQuality,currentWeather,forecastDaily,forecastHourly,forecastNextHour,locationInfo,news,historicalComparisons,weatherAlerts,weatherChanges",Weather.Provider:"ColorfulClouds",Weather.Replace:"CN",NextHour.Provider:"ColorfulClouds",WeatherAlerts.Provider:"QWeatherWeb",AirQuality.Current.Index.Provider:"ColorfulCloudsUS",AirQuality.Current.Index.Replace:"HJ6332012",AirQuality.Calculate.Algorithm:"WAQI_InstantCast_CN",API.ColorfulClouds.Token:"",API.QWeather.Host:"devapi.qweather.com",API.QWeather.Token:"",API.WAQI.Token:"",LogLevel:"INFO"
#!arguments-desc = Weather.Provider: 天气数据源（ColorfulClouds 彩云 / QWeather 和风）。\nWeather.Replace: 替换范围国家码，默认 CN。\nNextHour.Provider: 分钟降水数据源（ColorfulClouds / WeatherKit 不替换）。\nWeatherAlerts.Provider: 预警来源（QWeatherWeb 网页补全 / WeatherKit 不替换）。\nAirQuality.Current.Index.Provider: 空气指数来源。ColorfulCloudsUS 彩云美标 / ColorfulCloudsCN 彩云国标 / QWeather 和风 / WAQI 世界空气质量 / Calculate 本地计算。\nAirQuality.Current.Index.Replace: 需替换的原始标准，默认 HJ6332012。\nAirQuality.Calculate.Algorithm: 本地计算算法。None 不计算 / WAQI_InstantCast_CN 国标（与彩云一致）/ WAQI_InstantCast_US 美标 EPA / WAQI_InstantCast_CN_25_DRAFT 国标 2025 草案 / EU_EAQI 欧盟 / UBA 德国。仅 Provider 选 Calculate 时生效。\nAPI.ColorfulClouds.Token: 彩云令牌，留空用公共令牌。\nAPI.QWeather.Host: 和风 API 主机。\nAPI.QWeather.Token: 和风令牌，选和风时必填。\nAPI.WAQI.Token: WAQI 令牌（aqicn.org 免费申请），选 WAQI 时必填。\nLogLevel: 脚本内部日志等级。

[Rule]
DOMAIN,weather-analytics-events.apple.com,REJECT-DROP
DOMAIN-SUFFIX,tthr.apple.com,REJECT-DROP,extended-matching
DOMAIN,tether.edge.apple,REJECT-DROP,extended-matching
AND,((OR,((IP-ASN,714,no-resolve),(IP-ASN,6185,no-resolve))),(PROTOCOL,QUIC)),REJECT-DROP

[Script]
天气增强·空气质量量表 = type=http-request, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v[12]\/airQualityScale\/, engine=webview, script-path=https://raw.githubusercontent.com/lid007-a/rule/main/weatherkit/WeatherKit-WK3-Scale.js, argument=DataSets="{{{DataSets}}}"&Weather.Provider="{{{Weather.Provider}}}"&Weather.Replace="{{{Weather.Replace}}}"&NextHour.Provider="{{{NextHour.Provider}}}"&WeatherAlerts.Provider="{{{WeatherAlerts.Provider}}}"&AirQuality.Current.Index.Provider="{{{AirQuality.Current.Index.Provider}}}"&AirQuality.Current.Index.Replace="{{{AirQuality.Current.Index.Replace}}}"&AirQuality.Calculate.Algorithm="{{{AirQuality.Calculate.Algorithm}}}"&API.ColorfulClouds.Token="{{{API.ColorfulClouds.Token}}}"&API.QWeather.Host="{{{API.QWeather.Host}}}"&API.QWeather.Token="{{{API.QWeather.Token}}}"&API.WAQI.Token="{{{API.WAQI.Token}}}"&LogLevel="{{{LogLevel}}}"
天气增强·WK3响应 = type=http-response, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v[23]\/weather\/, requires-body=1, binary-body-mode=1, engine=webview, script-path=https://raw.githubusercontent.com/lid007-a/rule/main/weatherkit/WeatherKit-WK3-Response-v19.js, argument=DataSets="{{{DataSets}}}"&Weather.Provider="{{{Weather.Provider}}}"&Weather.Replace="{{{Weather.Replace}}}"&NextHour.Provider="{{{NextHour.Provider}}}"&WeatherAlerts.Provider="{{{WeatherAlerts.Provider}}}"&AirQuality.Current.Index.Provider="{{{AirQuality.Current.Index.Provider}}}"&AirQuality.Current.Index.Replace="{{{AirQuality.Current.Index.Replace}}}"&AirQuality.Calculate.Algorithm="{{{AirQuality.Calculate.Algorithm}}}"&API.ColorfulClouds.Token="{{{API.ColorfulClouds.Token}}}"&API.QWeather.Host="{{{API.QWeather.Host}}}"&API.QWeather.Token="{{{API.QWeather.Token}}}"&API.WAQI.Token="{{{API.WAQI.Token}}}"&LogLevel="{{{LogLevel}}}"

[MITM]
hostname = %APPEND% weatherkit.apple.com
