#!name = 🌤 天气增强 · WK3 Plus
#!desc = 当前、逐小时、逐日由彩云替换；无空气质量表的点位注入彩云国标指数；分钟降水与预警沿用底座实现。脚本日志带「天气增强」前缀。
#!system = iOS
#!version = 1.4.0
#!homepage = https://github.com/patrickyanxxxxx/WeatherKit-WK3

[Rule]
DOMAIN,weather-analytics-events.apple.com,REJECT-DROP
DOMAIN-SUFFIX,tthr.apple.com,REJECT-DROP,extended-matching
DOMAIN,tether.edge.apple,REJECT-DROP,extended-matching
AND,((OR,((IP-ASN,714,no-resolve),(IP-ASN,6185,no-resolve))),(PROTOCOL,QUIC)),REJECT-DROP

[Script]
天气增强·空气质量量表 = type=http-request, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v[12]\/airQualityScale\/, engine=webview, script-path=https://raw.githubusercontent.com/lid007-a/rule/main/weatherkit/WeatherKit-WK3-Scale.js, argument=DataSets="airQuality,currentWeather,forecastDaily,forecastHourly,forecastNextHour,locationInfo,news,historicalComparisons,weatherAlerts,weatherChanges"&Weather.Replace="CN"&Weather.Provider="ColorfulClouds"&WeatherAlerts.Provider="QWeatherWeb"&NextHour.Provider="ColorfulClouds"&AirQuality.Current.Index.Provider="ColorfulCloudsUS"&AirQuality.Current.Index.Replace="HJ6332012"&AirQuality.Current.Index.ForceCNPrimaryPollutants="true"&AirQuality.Current.Pollutants.Provider="ColorfulClouds"&AirQuality.Comparison.ReplaceWhenCurrentChange="true"&AirQuality.Comparison.Yesterday.IndexProvider="ColorfulCloudsUS"&AirQuality.Calculate.Algorithm="WAQI_InstantCast_US"&API.ColorfulClouds.Token=""&API.QWeather.Host="devapi.qweather.com"&API.QWeather.Token=""&LogLevel="INFO"&HTTP_TIMEOUT_MS="8000"
天气增强·WK3响应 = type=http-response, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v3\/weather\/, requires-body=1, binary-body-mode=1, engine=webview, script-path=https://raw.githubusercontent.com/lid007-a/rule/main/weatherkit/WeatherKit-WK3-Response-Log2.js, argument=DataSets="airQuality,currentWeather,forecastDaily,forecastHourly,forecastNextHour,locationInfo,news,historicalComparisons,weatherAlerts,weatherChanges"&Weather.Replace="CN"&Weather.Provider="ColorfulClouds"&WeatherAlerts.Provider="QWeatherWeb"&NextHour.Provider="ColorfulClouds"&AirQuality.Current.Index.Provider="ColorfulCloudsUS"&AirQuality.Current.Index.Replace="HJ6332012"&AirQuality.Current.Index.ForceCNPrimaryPollutants="true"&AirQuality.Current.Pollutants.Provider="ColorfulClouds"&AirQuality.Comparison.ReplaceWhenCurrentChange="true"&AirQuality.Comparison.Yesterday.IndexProvider="ColorfulCloudsUS"&AirQuality.Calculate.Algorithm="WAQI_InstantCast_US"&API.ColorfulClouds.Token=""&API.QWeather.Host="devapi.qweather.com"&API.QWeather.Token=""&LogLevel="INFO"&HTTP_TIMEOUT_MS="8000"

[MITM]
hostname = %APPEND% weatherkit.apple.com
