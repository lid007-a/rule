#!name = 🌤 天气增强 · WK3 Plus
#!desc = 最终版。当前、逐小时、逐日可由彩云或和风替换，含逐小时图标同步；空气质量支持彩云美标/国标、和风、WAQI、本地 11 种算法；无数据表点位自动补入；分钟降水含兜底注入、无雨清理与强度调节；可用性响应同步重写。
#!system = iOS
#!version = 3.0.2
#!homepage = https://github.com/patrickyanxxxxx/WeatherKit-WK3
#!arguments = DataSets:"airQuality,currentWeather,forecastDaily,forecastHourly,forecastNextHour,locationInfo,news,historicalComparisons,weatherAlerts,weatherChanges",Weather.Provider:"ColorfulClouds",Weather.Replace:"CN",Weather.ReplaceConditionCode:"true",NextHour.Provider:"ColorfulClouds",NextHour.IntensityScale:"1",NextHour.MinIntensity:"0",NextHour.PeakIntensity:"0",WeatherAlerts.Provider:"QWeatherWeb",AirQuality.Current.Index.Provider:"ColorfulCloudsUS",AirQuality.Current.Index.Replace:"HJ6332012,EPA_NowCast",AirQuality.Calculate.Algorithm:"WAQI_InstantCast_CN",AirQuality.Calculate.AllowOverRange:"true",AirQuality.Comparison.ReplaceWhenCurrentChange:"true",AirQuality.Comparison.Yesterday.IndexProvider:"ColorfulCloudsCN",AirQuality.Comparison.Yesterday.PollutantsProvider:"ColorfulCloudsCN",API.ColorfulClouds.Token:"",API.QWeather.Host:"devapi.qweather.com",API.QWeather.Token:"",API.WAQI.Token:"",LogLevel:"INFO"
#!arguments-desc = Weather.Provider: 天气数据源（ColorfulClouds 彩云 / QWeather 和风）。\nWeather.Replace: 替换范围国家码，默认 CN。\nWeather.ReplaceConditionCode: 是否同步逐小时天气图标（晴=1 / 阴=6 / 小雨=7 / 多云=23 / 局部多云=24 / 雨=25）。\nNextHour.Provider: 分钟降水数据源（ColorfulClouds / WeatherKit 不替换）。\nNextHour.IntensityScale: 分钟降水强度整体倍率，默认 1 不改变。重度雨也会被放大，慎用。\nNextHour.MinIntensity: 最低强度（mm/h），默认 0 关闭。开启后低于该值的有雨分钟被抬到该值，曲线会变平。\nNextHour.PeakIntensity: 峰值归一化（mm/h），默认 0 关闭。开启后若峰值低于该值，整体按比例放大，曲线形状保留。推荐 1.2。\nWeatherAlerts.Provider: 预警来源（QWeatherWeb 网页补全 / WeatherKit 不替换）。\nAirQuality.Current.Index.Provider: 空气指数来源。ColorfulCloudsUS / ColorfulCloudsCN / QWeather / WAQI / Calculate。\nAirQuality.Current.Index.Replace: 需替换的原始标准，默认 HJ6332012,EPA_NowCast（必须两个都填，否则美标点位不替换）。注意苹果不允许 EPA 反向转 HJ，原始为美标的点位只能用 US 输出。\nAirQuality.Calculate.Algorithm: 本地计算算法，共 11 种。仅 Provider 选 Calculate 时生效。\nAirQuality.Calculate.AllowOverRange: 指数超过 500 时是否保留原值。\nAirQuality.Comparison.*: 昨日对比相关设置。\nAPI.ColorfulClouds.Token / API.QWeather.Host / API.QWeather.Token / API.WAQI.Token: 各数据源令牌。\nLogLevel: 脚本内部日志等级。

[Rule]
DOMAIN,weather-analytics-events.apple.com,REJECT-DROP
DOMAIN-SUFFIX,tthr.apple.com,REJECT-DROP,extended-matching
DOMAIN,tether.edge.apple,REJECT-DROP,extended-matching
AND,((OR,((IP-ASN,714,no-resolve),(IP-ASN,6185,no-resolve))),(PROTOCOL,QUIC)),REJECT-DROP

[Script]
天气增强·可用性 = type=http-response, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v[12]\/availability\/, requires-body=1, engine=webview, script-path=https://raw.githubusercontent.com/lid007-a/rule/main/weatherkit/WeatherKit-WK3-Response-v31.js, argument=DataSets="{{{DataSets}}}"&Weather.Provider="{{{Weather.Provider}}}"&Weather.Replace="{{{Weather.Replace}}}"&Weather.ReplaceConditionCode="{{{Weather.ReplaceConditionCode}}}"&NextHour.Provider="{{{NextHour.Provider}}}"&NextHour.IntensityScale="{{{NextHour.IntensityScale}}}"&NextHour.MinIntensity="{{{NextHour.MinIntensity}}}"&NextHour.PeakIntensity="{{{NextHour.PeakIntensity}}}"&WeatherAlerts.Provider="{{{WeatherAlerts.Provider}}}"&AirQuality.Current.Index.Provider="{{{AirQuality.Current.Index.Provider}}}"&AirQuality.Current.Index.Replace="{{{AirQuality.Current.Index.Replace}}}"&AirQuality.Calculate.Algorithm="{{{AirQuality.Calculate.Algorithm}}}"&AirQuality.Calculate.AllowOverRange="{{{AirQuality.Calculate.AllowOverRange}}}"&AirQuality.Comparison.ReplaceWhenCurrentChange="{{{AirQuality.Comparison.ReplaceWhenCurrentChange}}}"&AirQuality.Comparison.Yesterday.IndexProvider="{{{AirQuality.Comparison.Yesterday.IndexProvider}}}"&AirQuality.Comparison.Yesterday.PollutantsProvider="{{{AirQuality.Comparison.Yesterday.PollutantsProvider}}}"&API.ColorfulClouds.Token="{{{API.ColorfulClouds.Token}}}"&API.QWeather.Host="{{{API.QWeather.Host}}}"&API.QWeather.Token="{{{API.QWeather.Token}}}"&API.WAQI.Token="{{{API.WAQI.Token}}}"&LogLevel="{{{LogLevel}}}"
天气增强·空气质量量表 = type=http-request, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v[12]\/airQualityScale\/, engine=webview, script-path=https://raw.githubusercontent.com/lid007-a/rule/main/weatherkit/WeatherKit-WK3-Scale.js, argument=DataSets="{{{DataSets}}}"&Weather.Provider="{{{Weather.Provider}}}"&Weather.Replace="{{{Weather.Replace}}}"&Weather.ReplaceConditionCode="{{{Weather.ReplaceConditionCode}}}"&NextHour.Provider="{{{NextHour.Provider}}}"&NextHour.IntensityScale="{{{NextHour.IntensityScale}}}"&NextHour.MinIntensity="{{{NextHour.MinIntensity}}}"&NextHour.PeakIntensity="{{{NextHour.PeakIntensity}}}"&WeatherAlerts.Provider="{{{WeatherAlerts.Provider}}}"&AirQuality.Current.Index.Provider="{{{AirQuality.Current.Index.Provider}}}"&AirQuality.Current.Index.Replace="{{{AirQuality.Current.Index.Replace}}}"&AirQuality.Calculate.Algorithm="{{{AirQuality.Calculate.Algorithm}}}"&AirQuality.Calculate.AllowOverRange="{{{AirQuality.Calculate.AllowOverRange}}}"&AirQuality.Comparison.ReplaceWhenCurrentChange="{{{AirQuality.Comparison.ReplaceWhenCurrentChange}}}"&AirQuality.Comparison.Yesterday.IndexProvider="{{{AirQuality.Comparison.Yesterday.IndexProvider}}}"&AirQuality.Comparison.Yesterday.PollutantsProvider="{{{AirQuality.Comparison.Yesterday.PollutantsProvider}}}"&API.ColorfulClouds.Token="{{{API.ColorfulClouds.Token}}}"&API.QWeather.Host="{{{API.QWeather.Host}}}"&API.QWeather.Token="{{{API.QWeather.Token}}}"&API.WAQI.Token="{{{API.WAQI.Token}}}"&LogLevel="{{{LogLevel}}}"
天气增强·WK3响应 = type=http-response, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v[23]\/weather\/, requires-body=1, binary-body-mode=1, engine=webview, script-path=https://raw.githubusercontent.com/lid007-a/rule/main/weatherkit/WeatherKit-WK3-Response-v31.js, argument=DataSets="{{{DataSets}}}"&Weather.Provider="{{{Weather.Provider}}}"&Weather.Replace="{{{Weather.Replace}}}"&Weather.ReplaceConditionCode="{{{Weather.ReplaceConditionCode}}}"&NextHour.Provider="{{{NextHour.Provider}}}"&NextHour.IntensityScale="{{{NextHour.IntensityScale}}}"&NextHour.MinIntensity="{{{NextHour.MinIntensity}}}"&NextHour.PeakIntensity="{{{NextHour.PeakIntensity}}}"&WeatherAlerts.Provider="{{{WeatherAlerts.Provider}}}"&AirQuality.Current.Index.Provider="{{{AirQuality.Current.Index.Provider}}}"&AirQuality.Current.Index.Replace="{{{AirQuality.Current.Index.Replace}}}"&AirQuality.Calculate.Algorithm="{{{AirQuality.Calculate.Algorithm}}}"&AirQuality.Calculate.AllowOverRange="{{{AirQuality.Calculate.AllowOverRange}}}"&AirQuality.Comparison.ReplaceWhenCurrentChange="{{{AirQuality.Comparison.ReplaceWhenCurrentChange}}}"&AirQuality.Comparison.Yesterday.IndexProvider="{{{AirQuality.Comparison.Yesterday.IndexProvider}}}"&AirQuality.Comparison.Yesterday.PollutantsProvider="{{{AirQuality.Comparison.Yesterday.PollutantsProvider}}}"&API.ColorfulClouds.Token="{{{API.ColorfulClouds.Token}}}"&API.QWeather.Host="{{{API.QWeather.Host}}}"&API.QWeather.Token="{{{API.QWeather.Token}}}"&API.WAQI.Token="{{{API.WAQI.Token}}}"&LogLevel="{{{LogLevel}}}"

[MITM]
hostname = %APPEND% weatherkit.apple.com
