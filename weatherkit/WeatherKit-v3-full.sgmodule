#!name = WeatherKit v3 完整修复
#!desc = iOS 27.3 (WeatherKit v3) 适配：降水强度、空气质量、天气数据。需关闭官方 iRingo WeatherKit。
#!author = VirgilClyne, WordlessEcho, 001, hhh2210 / wang01h2 (v3 patch)
#!homepage = https://github.com/wang01h2/WeatherKit
#!version = 3.3.2-v3
#!system = iOS

[Rule]
DOMAIN,weather-analytics-events.apple.com,REJECT-DROP
DOMAIN-SUFFIX,tthr.apple.com,REJECT-DROP,extended-matching
DOMAIN,tether.edge.apple,REJECT-DROP,extended-matching
AND,((OR,((IP-ASN,714,no-resolve),(IP-ASN,6185,no-resolve))),(PROTOCOL,QUIC)),REJECT-DROP

[Script]
🌤 WK v3 完整 = type=http-response, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v3\/weather\/, requires-body=1, binary-body-mode=1, engine=webview, script-path=https://raw.githubusercontent.com/lid007-a/rule/main/weatherkit/wk-v3-fork-latest.js, argument=DataSets="airQuality,currentWeather,forecastDaily,forecastHourly,forecastNextHour,weatherAlerts"&Weather.Provider="ColorfulClouds"&WeatherAlerts.Provider="QWeatherWeb"&NextHour.Provider="ColorfulClouds"&AirQuality.Current.Pollutants.Provider="ColorfulClouds"&AirQuality.Calculate.Algorithm="EU_EAQI"&API.ColorfulClouds.Token=""&API.QWeather.Host="devapi.qweather.com"&API.QWeather.Token=""&API.WAQI.Token=""&Storage="Argument"&LogLevel="WARN"

[MITM]
hostname = %APPEND% weatherkit.apple.com
