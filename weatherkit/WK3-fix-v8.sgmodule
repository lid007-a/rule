#!name = WeatherKit WK3 修复版
#!desc = 修复上游 v3.3.3 的五个 bug；补上 currentWeather / forecastHourly / forecastDaily 的彩云数据替换（原地改写，只改已验证类型的标量）。
#!system = iOS
#!version = 3.3.3-fix.8
#!homepage = https://github.com/patrickyanxxxxx/WeatherKit-WK3

[Rule]
DOMAIN,weather-analytics-events.apple.com,REJECT-DROP
DOMAIN-SUFFIX,tthr.apple.com,REJECT-DROP,extended-matching
DOMAIN,tether.edge.apple,REJECT-DROP,extended-matching
AND,((OR,((IP-ASN,714,no-resolve),(IP-ASN,6185,no-resolve))),(PROTOCOL,QUIC)),REJECT-DROP

[Script]
WK3量表 = type=http-request, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v[12]\/airQualityScale\/, engine=webview, script-path=https://raw.githubusercontent.com/lid007-a/rule/main/weatherkit/wk3-fix-req-v1.js, argument=DataSets="airQuality,currentWeather,forecastDaily,forecastHourly,forecastNextHour,locationInfo,news,historicalComparisons,weatherAlerts,weatherChanges"&Weather.Replace="CN"&Weather.Provider="ColorfulClouds"&Weather.ReplaceDaily="true"&Weather.ReplaceHourly="true"&WeatherAlerts.Provider="QWeatherWeb"&NextHour.Provider="ColorfulClouds"&AirQuality.Current.Index.Provider="ColorfulCloudsUS"&AirQuality.Current.Index.Replace="HJ6332012"&AirQuality.Current.Index.ForceCNPrimaryPollutants="true"&AirQuality.Current.Pollutants.Provider="ColorfulClouds"&AirQuality.Comparison.ReplaceWhenCurrentChange="true"&AirQuality.Comparison.Yesterday.IndexProvider="ColorfulCloudsUS"&AirQuality.Calculate.Algorithm="WAQI_InstantCast_US"&API.ColorfulClouds.Token=""&API.QWeather.Host="devapi.qweather.com"&API.QWeather.Token=""&LogLevel="INFO"&HTTP_TIMEOUT_MS="8000"
WK3本地响应 = type=http-response, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v3\/weather\/, requires-body=1, binary-body-mode=1, engine=webview, script-path=https://raw.githubusercontent.com/lid007-a/rule/main/weatherkit/wk3-fix-v7.js, argument=DataSets="airQuality,currentWeather,forecastDaily,forecastHourly,forecastNextHour,locationInfo,news,historicalComparisons,weatherAlerts,weatherChanges"&Weather.Replace="CN"&Weather.Provider="ColorfulClouds"&Weather.ReplaceDaily="true"&Weather.ReplaceHourly="true"&WeatherAlerts.Provider="QWeatherWeb"&NextHour.Provider="ColorfulClouds"&AirQuality.Current.Index.Provider="ColorfulCloudsUS"&AirQuality.Current.Index.Replace="HJ6332012"&AirQuality.Current.Index.ForceCNPrimaryPollutants="true"&AirQuality.Current.Pollutants.Provider="ColorfulClouds"&AirQuality.Comparison.ReplaceWhenCurrentChange="true"&AirQuality.Comparison.Yesterday.IndexProvider="ColorfulCloudsUS"&AirQuality.Calculate.Algorithm="WAQI_InstantCast_US"&API.ColorfulClouds.Token=""&API.QWeather.Host="devapi.qweather.com"&API.QWeather.Token=""&LogLevel="INFO"&HTTP_TIMEOUT_MS="8000"

[MITM]
hostname = %APPEND% weatherkit.apple.com
