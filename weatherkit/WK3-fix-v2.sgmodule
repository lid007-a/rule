#!name = WeatherKit WK3 修复版
#!desc = 修复上游 v3.3.3 Surge bundle：$done 返回形式、彩云缺 User-Agent、概率乘两次 100、降水类型关键词缺「降水」。
#!system = iOS
#!version = 3.3.3-fix.2
#!homepage = https://github.com/patrickyanxxxxx/WeatherKit-WK3

[Script]
WK3量表 = type=http-request, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v[12]\/airQualityScale\/, engine=webview, script-path=https://raw.githubusercontent.com/lid007-a/rule/main/weatherkit/wk3-fix-req-v1.js, argument=DataSets="airQuality,currentWeather,forecastDaily,forecastHourly,forecastNextHour,locationInfo,news,historicalComparisons,weatherAlerts,weatherChanges"&Weather.Replace="CN"&Weather.Provider="ColorfulClouds"&WeatherAlerts.Provider="QWeatherWeb"&NextHour.Provider="ColorfulClouds"&AirQuality.Current.Index.Provider="ColorfulCloudsUS"&AirQuality.Current.Index.Replace="HJ6332012"&AirQuality.Current.Index.ForceCNPrimaryPollutants="true"&AirQuality.Current.Pollutants.Provider="ColorfulClouds"&AirQuality.Comparison.ReplaceWhenCurrentChange="true"&AirQuality.Comparison.Yesterday.IndexProvider="ColorfulCloudsUS"&AirQuality.Calculate.Algorithm="WAQI_InstantCast_US"&API.ColorfulClouds.Token=""&API.QWeather.Host="devapi.qweather.com"&API.QWeather.Token=""&LogLevel="INFO"&HTTP_TIMEOUT_MS="8000"
WK3本地响应 = type=http-response, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v3\/weather\/, requires-body=1, binary-body-mode=1, engine=webview, script-path=https://raw.githubusercontent.com/lid007-a/rule/main/weatherkit/wk3-fix-v1.js, argument=DataSets="airQuality,currentWeather,forecastDaily,forecastHourly,forecastNextHour,locationInfo,news,historicalComparisons,weatherAlerts,weatherChanges"&Weather.Replace="CN"&Weather.Provider="ColorfulClouds"&WeatherAlerts.Provider="QWeatherWeb"&NextHour.Provider="ColorfulClouds"&AirQuality.Current.Index.Provider="ColorfulCloudsUS"&AirQuality.Current.Index.Replace="HJ6332012"&AirQuality.Current.Index.ForceCNPrimaryPollutants="true"&AirQuality.Current.Pollutants.Provider="ColorfulClouds"&AirQuality.Comparison.ReplaceWhenCurrentChange="true"&AirQuality.Comparison.Yesterday.IndexProvider="ColorfulCloudsUS"&AirQuality.Calculate.Algorithm="WAQI_InstantCast_US"&API.ColorfulClouds.Token=""&API.QWeather.Host="devapi.qweather.com"&API.QWeather.Token=""&LogLevel="INFO"&HTTP_TIMEOUT_MS="8000"

[MITM]
hostname = %APPEND% weatherkit.apple.com
